# ===================================================================
# INTERNET IA - CONFIGURAÇÃO DO SERVIDOR PROXY
# ===================================================================

# ===== SERVIDOR =====
PORT=3000
NODE_ENV=development

# ===== CORS =====
# Domínios permitidos (separados por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# ===== RATE LIMIT =====
RATE_LIMIT_WINDOW=15          # Minutos
RATE_LIMIT_MAX=100            # Requisições por IP

# ===== CACHE =====
ENABLE_CACHE=true
CACHE_TTL=300                 # Segundos (5 minutos)

# ===== TIMEOUTS =====
REQUEST_TIMEOUT=30000         # 30 segundos (padrão)
CHAT_TIMEOUT=60000            # 60 segundos (chat)
IMAGE_TIMEOUT=60000           # 60 segundos (imagem)
FILES_TIMEOUT=60000           # 60 segundos (arquivos)
SEARCH_TIMEOUT=30000          # 30 segundos (busca)

# ===== PAYLOAD =====
MAX_PAYLOAD_SIZE=10mb

# ===== API CHAT =====
CHAT_API_URL=https://gen.pollinations.ai/v1/chat/completions
CHAT_API_KEY=pk_bJav4nbMa2fZGkqG
CHAT_MODEL=openai

# ===== API IMAGEM =====
IMAGE_API_URL=https://image.pollinations.ai/prompt/
IMAGE_API_KEY=
